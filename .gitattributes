# Normalise line endings: LF in the repository, everywhere.
* text=auto eol=lf

# Source and text formats
*.py        text diff=python
*.toml      text
*.md        text diff=markdown
*.yml       text
*.yaml      text
*.json      text
*.svg       text diff=xml
*.tape      text

# Windows-only scripts keep CRLF
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary assets
*.png       binary
*.gif       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.webp      binary

# Generated files: collapse in diffs and exclude from language statistics
uv.lock                     linguist-generated=true -diff
docs/logoprism.schema.json  linguist-generated=true

# Keep the repo's language stats about Python
docs/**                     linguist-documentation

# Do not ship dev-only files in sdists / git archive
/.github/               export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.editorconfig          export-ignore
/samples/               export-ignore
